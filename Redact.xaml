<Window x:Class="dem.Redact"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование товара"
        Height="620" Width="430"
        WindowStartupLocation="CenterScreen" Icon="/Icon.png">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Артикул"/>
                <TextBox x:Name="txtArticle" Margin="0,3,0,8"/>

                <TextBlock Text="Название"/>
                <TextBox x:Name="txtName" Margin="0,3,0,8"/>

                <TextBlock Text="Единица измерения"/>
                <TextBox x:Name="txtEdIzm" Margin="0,3,0,8"/>

                <TextBlock Text="Цена"/>
                <TextBox x:Name="txtPrice" Margin="0,3,0,8"/>

                <TextBlock Text="Поставщик"/>
                <TextBox x:Name="txtPostav" Margin="0,3,0,8"/>

                <TextBlock Text="Производитель"/>
                <TextBox x:Name="txtProizvod" Margin="0,3,0,8"/>

                <TextBlock Text="Категория"/>
                <TextBox x:Name="txtCategoria" Margin="0,3,0,8"/>

                <TextBlock Text="Скидка (%)"/>
                <TextBox x:Name="txtSale" Margin="0,3,0,8"/>

                <TextBlock Text="Количество"/>
                <TextBox x:Name="txtKolichestvo" Margin="0,3,0,8"/>

                <TextBlock Text="Описание"/>
                <TextBox x:Name="txtDescription"
                         Height="55"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Margin="0,3,0,8"/>

                <TextBlock Text="Фотография"/>
                <TextBox x:Name="txtPhoto" Margin="0,3,0,8"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Сохранить"
                    Width="110" Height="30"
                    Background="#00FA9A"
                    Click="Save_Click"/>

            <Button Content="Отмена"
                    Width="110" Height="30"
                    Margin="10,0,0,0"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
