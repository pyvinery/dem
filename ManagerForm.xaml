<Window x:Class="dem.ManagerForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель менеджера"
        Height="600" Width="1100"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Icon="/Icon.png">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Панель менеджера"
                       FontSize="22"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <Button Content="Товары"
                    Width="100" Height="30"
                    Margin="30,0,0,0"
                    Background="#00FA9A"
                    Click="ShowProducts_Click"/>

            <Button Content="Заказы"
                    Width="100" Height="30"
                    Margin="10,0,0,0"
                    Background="#00FA9A"
                    Click="ShowOrders_Click"/>

            <Button Content="Выйти"
                    Width="90" Height="30"
                    Margin="550,0,0,0"
                    Background="#00FA9A"
                    Click="Exit_Click"/>
        </StackPanel>

        <DataGrid x:Name="dgProducts"
                  Grid.Row="1"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"/>

        <DataGrid x:Name="dgOrders"
                  Grid.Row="1"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  Visibility="Collapsed"/>
    </Grid>
</Window>
