<Window x:Class="dem.AdminForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель администратора"
        Height="600" Width="1100"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Icon="/Icon.png">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Управление товарами"
                       FontSize="22"
                       FontWeight="Bold"/>
            <Button Content="Выйти"
                    Width="90"
                    Height="30"
                    DockPanel.Dock="Right"
                    Background="#00FA9A"
                    Click="Exit_Click"/>
        </DockPanel>

        <DataGrid x:Name="dgData"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionChanged="dgData_SelectionChanged">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Артикул" Binding="{Binding Articul}" Width="100"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Ед. изм." Binding="{Binding EdIzm}" Width="80"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="90"/>
                <DataGridTextColumn Header="Поставщик" Binding="{Binding Postav}" Width="120"/>
                <DataGridTextColumn Header="Производитель" Binding="{Binding Proizvod}" Width="120"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Categoria}" Width="120"/>
                <DataGridTextColumn Header="Скидка" Binding="{Binding Sale}" Width="70"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Kolichestvo}" Width="90"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,10,0,0">
            <Button Content="Добавить"
                    Width="110" Height="32"
                    Background="#00FA9A"
                    Click="btnAdd_Click"/>

            <Button Content="Изменить"
                    Width="110" Height="32"
                    Margin="10,0,0,0"
                    Background="#00FA9A"
                    Click="btnEdit_Click"/>

            <Button Content="Удалить"
                    Width="110" Height="32"
                    Margin="10,0,0,0"
                    Background="#00FA9A"
                    Click="btnDelete_Click"/>
        </StackPanel>
    </Grid>
</Window>
